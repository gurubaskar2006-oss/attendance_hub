{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js",
      "installCommand": "npm install --omit=dev",
      "buildCommand": "node -e \"console.log('server dist ready')\""
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "server",
        "path": "/health"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
