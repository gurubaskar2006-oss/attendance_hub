# ===================================================
# School Operations Platform - Environment Configuration
# 6th Civilians Corporation
# ===================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_characters
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_replace_in_production_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=cookie_secret_key_minimum_32_characters_here

# Database Configuration
# Standard local/Atlas MongoDB URI.
# If left as 'memory' or empty in development, the platform automatically boots an embedded in-memory MongoDB runner.
MONGODB_URI=mongodb://localhost:27017/school_operations_platform

# Redis / Queue Configuration (Optional)
# If REDIS_URL is empty, system gracefully falls back to reliable in-process asynchronous task execution
REDIS_URL=

# Storage Provider (options: 'local' | 's3')
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3 Credentials (Required only if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# SMS Gateway Configuration (Optional - simulated logging adapter used when unconfigured)
SMS_PROVIDER=msg91
SMS_AUTH_KEY=
SMS_SENDER_ID=SCHOPS
SMS_ROUTE=4

# WhatsApp Business Cloud API Configuration (Optional - simulated logging adapter used when unconfigured)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# CORS Configuration
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

